# Copy to .env and fill in real values. Never commit .env.
# This repo covers two tracks — fill in only the sections you need.

# =============================================================================
# Shared — Microsoft Foundry resource (used by both tracks)
# =============================================================================

# Azure tenant and subscription that own the Foundry resource
TENANT_ID=00000000-0000-0000-0000-000000000000
SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Resource group containing the Foundry account
RESOURCE_GROUP=<resource-group>

# Foundry / AI Services account + Claude model deployment
FOUNDRY_ACCOUNT=<foundry-account>
FOUNDRY_DEPLOYMENT=claude-sonnet-4-6

# Foundry endpoint (https://<custom-subdomain>.services.ai.azure.com)
AZURE_AI_FOUNDRY_ENDPOINT=https://<foundry-account>.services.ai.azure.com

# =============================================================================
# Track A — Claude Code (CLI + VS Code, direct path)
# =============================================================================
# These are read by Claude Code itself, not by any script in this repo.
# Set them in your shell (or in vscode-settings.sample.json) before launching.

# CLAUDE_CODE_USE_FOUNDRY=1
# ANTHROPIC_FOUNDRY_RESOURCE=<foundry-account>

# =============================================================================
# Track B — Claude Desktop via Azure API Management
# =============================================================================

# Azure region (only needed when scripts/claude-desktop/create-apim.ps1 has to
# provision a new resource group or APIM service, e.g. eastus2, swedencentral).
LOCATION=<azure-region>

# API Management service name (globally unique when created)
APIM_NAME=<apim-name>

# APIM tier. Consumption provisions in minutes; Developer/Basic/Standard/Premium
# take 30-45 min.
APIM_SKU=Consumption

# Required by Azure when creating a new APIM service
APIM_PUBLISHER_EMAIL=<you@example.com>
APIM_PUBLISHER_NAME=Claude Gateway Admin

# Entra app registration for Claude Desktop SSO
APP_DISPLAY_NAME=Claude Cowork gateway
REDIRECT_URI=http://127.0.0.1/callback
